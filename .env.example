# 复制本文件为 .env 后填入真实密钥。不要提交 .env，不要加 VITE_ 前缀。

# 阿里云百炼。控制台：https://bailian.console.aliyun.com/
# 密钥只显示一次。Base URL 填控制台「OpenAI 兼容」那一行，不要用 Anthropic。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 第 2 周改字（旧名 qwen-plus）
DASHSCOPE_REWRITE_MODEL=qwen3.6-flash
# 第 3 周看图拆单（旧名 qwen-vl-max）
DASHSCOPE_PLANNER_MODEL=qwen3-vl-plus

# fal：一把 Key 同时用于重画和轮廓。https://fal.ai/dashboard/keys
FAL_KEY=
# 第 2 周按像素 mask 局部重画
FAL_INPAINT_MODEL=fal-ai/flux-pro/v1/fill
# 第 3 周求轮廓
FAL_SAM_MODEL=fal-ai/sam2/image

# 可选。抓淘宝/需要登录或前端渲染的页时用。
# 到 https://www.browserless.io 注册并充值，填 API token。不填则只能抓静态 HTML，或改用「HTML 文件」。
BROWSERLESS_API_KEY=
# BROWSERLESS_URL=https://production-sfo.browserless.io

# 必须为 1，页面再勾「允许调用云端模型」，才会打百炼/fal。套索、改界面、检查接口、导入网页不消耗额度。
MARKSET_ALLOW_MODEL_CALLS=0
