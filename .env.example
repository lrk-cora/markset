# 后端配置：不要使用 VITE_ 前缀；.env 和任务账本禁止提交。
MARKSET_PROVIDER=bailian
# 必须先用同一地域 /models 验证 Key，禁止跨地域混用。
MARKSET_BAILIAN_REGION=cn-beijing
# 在本机 .env 中填写私有密钥文件的绝对路径；模板不包含个人路径或 Key。
MARKSET_BAILIAN_KEY_FILE=
# 可改为服务器私有环境变量 MARKSET_BAILIAN_API_KEY，不能同时公开两者。
MARKSET_BAILIAN_FLASH_MODEL=qwen3.8-flash
# 当前分析固定使用 Flash，包括视觉与组合操作，不自动升级到 Max。
MARKSET_BAILIAN_MAX_MODEL=qwen3.8-max
MARKSET_BAILIAN_IMAGE_MODEL=qwen-image-3.0
MARKSET_BAILIAN_IMAGE_PRO_MODEL=qwen-image-3.0-pro
MARKSET_ALLOW_MODEL_CALLS=0
# 分析临时错误最多重试两次；总时限覆盖连接、响应正文、退避。
# 方案只生成一次，不自动修复或重生成；格式/安全失败后由用户决定是否重试。
# 首次有效输出等待（响应头/心跳不延长）；不是整次流式输出时限。
MARKSET_MODEL_TIMEOUT_MS=30000
# 有效输出之间最大空闲时间；持续输出不重新提交模型请求。
MARKSET_MODEL_IDLE_TIMEOUT_MS=15000
MARKSET_MODEL_TOTAL_TIMEOUT_MS=60000
# 图片仅安全重试一次；已知任务只查询原任务，未知状态不重新提交。
MARKSET_IMAGE_TIMEOUT_MS=180000
# 可选渲染导入服务，和模型配置独立。
BROWSERLESS_API_KEY=
