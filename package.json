    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vite": "^6.3.5"
  }
