{
  "name": "markset",
  "version": "0.1.0",
  "private": true,
  "description": "MarkSet week-1 experiment: lasso text and image regions into one numbered selection.",
  "type": "module",
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  },
  "scripts": {
